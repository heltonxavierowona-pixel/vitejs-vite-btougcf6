# Configuration de docker-compose.yml — copier en .env
POSTGRES_PASSWORD=change_me
# openssl rand -base64 48
JWT_ACCESS_SECRET=

# Adresses publiques (à adapter en production, derrière HTTPS)
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000/api

# Paiement des abonnements : "manual" (lien Neero, défaut) ou "online"
PAYMENT_MODE=manual
PLATFORM_ADMIN_EMAILS=
# Notifications : bot Telegram (administrateur), SMTP (clients)
TELEGRAM_BOT_TOKEN=
# WhatsApp vers votre numéro (CallMeBot, gratuit)
WHATSAPP_NOTIFY_PHONE=
WHATSAPP_NOTIFY_APIKEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Notch Pay — Mobile Money et carte (PAYMENT_MODE=online)
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=

# Stripe — paiement par carte (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave — Mobile Money (facultatif en local)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Neero (encaissement automatique, PAYMENT_MODE=online) ----
# Un opérateur et une balance par projet NUMERA. Guide : docs/NEERO.md
NEERO_ENV=sandbox
NEERO_BASE_URL=
NEERO_SECRET_KEY=
NEERO_WEBHOOK_SECRET=
NEERO_OPERATOR_ID=
NEERO_MERCHANT_KEY=
NEERO_STORE_ID=
NEERO_BALANCE_ID=
NEERO_DESTINATION_PAYMENT_METHOD_ID=
APP_PUBLIC_URL=
# À confirmer en Sandbox (valeurs par défaut dans api/src/payments/neero/neero.config.ts)
NEERO_AUTH_HEADER=
NEERO_AUTH_SCHEME=
NEERO_CASH_IN_PAYMENT_TYPE=
NEERO_MERCHANT_METHOD_TYPE=
NEERO_SESSION_URL_FIELD=
NEERO_PATH_TRANSACTION=
NEERO_PATH_CANCEL=
# Délai de grâce après échéance (15 jours par défaut, annoncé dans les CGV)
GRACE_PERIOD_DAYS=
