# Configuration de docker-compose.yml — copier en .env
POSTGRES_PASSWORD=change_me
# openssl rand -base64 48
JWT_ACCESS_SECRET=

# Adresses publiques (à adapter en production, derrière HTTPS)
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000/api

# Notch Pay — Mobile Money et carte (paiement des abonnements)
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=

# Stripe — paiement par carte (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave — Mobile Money (facultatif en local)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
