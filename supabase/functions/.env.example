# Secrets des Edge Functions : supabase secrets set --env-file supabase/functions/.env
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
APP_ORIGIN=https://app.votredomaine.com
# Rédaction des messages (Partie 3) : modèle plus fort que pour le tri
OPENROUTER_WRITE_MODEL=anthropic/claude-sonnet-4.5
# Secret partagé avec n8n (workflow 03 → update-profile)
NUMERA_WEBHOOK_SECRET=
# Abonnements (docs/08) : ne renseignez que les moyens de paiement que vous activez.
# Les pages de retour après paiement utilisent APP_ORIGIN (ex. https://app.votredomaine.com/abonnement).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# E-mails (docs/08) : envoyés depuis votre Gmail par la fonction send-email.
# SMTP_PASS = mot de passe d'application Google (16 caractères), pas votre mot de passe Gmail.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM_NAME=Numera Agentic
