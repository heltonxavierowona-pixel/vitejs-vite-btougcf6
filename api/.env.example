# ============================================================
#  API Numera — copier en .env et remplir. NE JAMAIS COMMITER .env
# ============================================================

NODE_ENV=development
PORT=3000

# ---- Base de données ----
DATABASE_URL="postgresql://numera:change_me@localhost:5432/numera?schema=public"

# ---- Sécurité ----
# Obligatoire, 32 caractères minimum. Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001
# Nombre de reverse proxies devant l'API (pour l'IP réelle du client)
TRUST_PROXY_HOPS=1

# ---- Paiement des abonnements ----
# Par défaut (vide ou "manual") : lien de paiement Neero envoyé à la main
# depuis l'écran /admin/paiements. "online" réactive Notch Pay, Stripe…
PAYMENT_MODE=manual
# Administrateurs de la plateforme (accès à /admin/paiements), séparés par des virgules
PLATFORM_ADMIN_EMAILS=

# ---- Notifications ----
# Bot Telegram (BotFather > /newbot) : vous prévient à chaque demande
TELEGRAM_BOT_TOKEN=
# WhatsApp vers votre numéro (CallMeBot, gratuit)
WHATSAPP_NOTIFY_PHONE=
WHATSAPP_NOTIFY_APIKEY=
# Facultatif : la conversation se relie depuis l'écran admin
TELEGRAM_CHAT_ID=
# E-mails aux clients (ex. Gmail : smtp.gmail.com, 465, mot de passe d'application)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Notch Pay (PAYMENT_MODE=online : MTN Mobile Money, Orange Money, carte) ----
# Notch Pay > Paramètres > Développeurs : clé publique
NOTCHPAY_PUBLIC_KEY=
# Clé de hachage des webhooks (https://<votre-api>/api/webhooks/notchpay)
NOTCHPAY_HASH_KEY=

# ---- Stripe (facultatif : carte avec renouvellement automatique) ----
# Clé secrète : Stripe > Développeurs > Clés API (sk_test_… pour tester)
STRIPE_SECRET_KEY=
# Secret de signature du webhook https://<votre-api>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---- Flutterwave (abonnements par Mobile Money) ----
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Application ----
FRONTEND_URL=http://localhost:3001
SUPPORT_EMAIL=heltonxavierowona@gmail.com

# ---- Neero (encaissement automatique, PAYMENT_MODE=online) ----
# Un opérateur et une balance par projet NUMERA. Guide : docs/NEERO.md
NEERO_ENV=sandbox
NEERO_BASE_URL=
NEERO_SECRET_KEY=
NEERO_WEBHOOK_SECRET=
NEERO_OPERATOR_ID=
NEERO_MERCHANT_KEY=
NEERO_STORE_ID=
NEERO_BALANCE_ID=
NEERO_DESTINATION_PAYMENT_METHOD_ID=
APP_PUBLIC_URL=
# À confirmer en Sandbox (valeurs par défaut dans api/src/payments/neero/neero.config.ts)
NEERO_AUTH_HEADER=
NEERO_AUTH_SCHEME=
NEERO_CASH_IN_PAYMENT_TYPE=
NEERO_MERCHANT_METHOD_TYPE=
NEERO_SESSION_URL_FIELD=
NEERO_PATH_TRANSACTION=
NEERO_PATH_CANCEL=
# Délai de grâce après échéance (15 jours par défaut, annoncé dans les CGV)
GRACE_PERIOD_DAYS=
