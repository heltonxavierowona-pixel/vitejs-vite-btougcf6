# ============================================================
#  API Numera — copier en .env et remplir. NE JAMAIS COMMITER .env
# ============================================================

NODE_ENV=development
PORT=3000

# ---- Base de données ----
DATABASE_URL="postgresql://numera:change_me@localhost:5432/numera?schema=public"

# ---- Sécurité ----
# Obligatoire, 32 caractères minimum. Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001
# Nombre de reverse proxies devant l'API (pour l'IP réelle du client)
TRUST_PROXY_HOPS=1

# ---- Notch Pay (abonnements : MTN Mobile Money, Orange Money, carte) ----
# Notch Pay > Paramètres > Développeurs : clé publique
NOTCHPAY_PUBLIC_KEY=
# Clé de hachage des webhooks (https://<votre-api>/api/webhooks/notchpay)
NOTCHPAY_HASH_KEY=

# ---- Stripe (facultatif : carte avec renouvellement automatique) ----
# Clé secrète : Stripe > Développeurs > Clés API (sk_test_… pour tester)
STRIPE_SECRET_KEY=
# Secret de signature du webhook https://<votre-api>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---- Flutterwave (abonnements par Mobile Money) ----
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Application ----
FRONTEND_URL=http://localhost:3001
SUPPORT_EMAIL=heltonxavierowona@gmail.com
