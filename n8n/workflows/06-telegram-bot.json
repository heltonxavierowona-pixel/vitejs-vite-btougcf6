{
  "name": "06 · Bot Telegram (liaison des alertes)",
  "nodes": [
    {
      "id": "t1",
      "name": "Message reçu par le bot",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "webhookId": "numera-telegram-bot",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "t2",
      "name": "Lire la commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "parameters": {
        "jsCode": "// Message reçu par le bot : « /start <code> » relie le Telegram à une organisation Numera Agentic.\nconst msg = $input.first().json.message || {};\nconst text = String(msg.text || '').trim();\nconst match = text.match(/^\\/start\\s+(nm_[a-f0-9]{32})$/);\nreturn [{ json: {\n  chat_id: String(msg.chat && msg.chat.id),\n  username: (msg.from && (msg.from.username || msg.from.first_name)) || null,\n  code: match ? match[1] : null,\n} }];\n"
      }
    },
    {
      "id": "t3",
      "name": "Code de liaison ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "t3c",
              "leftValue": "={{ $json.code }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "t4",
      "name": "Supabase · link_telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/link_telegram",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_code: $json.code, p_chat_id: $json.chat_id, p_username: $json.username }) }}",
        "options": {}
      }
    },
    {
      "id": "t5",
      "name": "Confirmer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        800,
        120
      ],
      "parameters": {
        "chatId": "={{ $('Lire la commande').item.json.chat_id }}",
        "text": "={{ $json.organization ? '✅ Alertes Numera Agentic activées pour « ' + $json.organization + ' ». Vous serez prévenu dès qu\\'un prospect devient chaud.' : '⚠️ Lien expiré ou déjà utilisé. Générez un nouveau lien dans Numera Agentic → Paramètres → Alertes.' }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      }
    },
    {
      "id": "t6",
      "name": "Aide",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "Bonjour ! Pour recevoir vos alertes, ouvrez Numera Agentic → Paramètres → Alertes → « Connecter Telegram ».",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      }
    }
  ],
  "connections": {
    "Message reçu par le bot": {
      "main": [
        [
          {
            "node": "Lire la commande",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lire la commande": {
      "main": [
        [
          {
            "node": "Code de liaison ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code de liaison ?": {
      "main": [
        [
          {
            "node": "Supabase · link_telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Aide",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase · link_telegram": {
      "main": [
        [
          {
            "node": "Confirmer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Douala"
  },
  "pinData": {}
}
