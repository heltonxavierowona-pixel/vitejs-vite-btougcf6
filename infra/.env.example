# ---- Domaine ----
N8N_DOMAIN=n8n.votredomaine.com

# ---- n8n ----
# openssl rand -hex 32   (À SAUVEGARDER : sans elle, les credentials sont perdus)
N8N_ENCRYPTION_KEY=

# ---- Supabase (la clé service_role se met dans le credential « Supabase » de n8n) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co

# ---- Meta (Facebook, Instagram, WhatsApp) ----
# Chaîne aléatoire de votre choix, recopiée dans App Meta → Webhooks
META_VERIFY_TOKEN=
# App Meta → Paramètres → Général → Clé secrète (sert à vérifier la signature des webhooks)
META_APP_SECRET=
# Mettre à true UNIQUEMENT pour un test ponctuel avec des webhooks simulés
META_SKIP_SIGNATURE=false

# ---- Telegram ----
TELEGRAM_CHAT_ID=
